#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
/ {
 keymap {
  compatible = "zmk,keymap";
  base {
   display-name = "QWERTY";
   bindings = <
    &kp Q &kp W &kp E &kp R &kp T  &kp Y &kp U &kp I &kp O &kp P
    &kp A &kp S &kp D &kp F &kp G  &kp H &kp J &kp K &kp L &kp SEMI
    &kp LSHFT &kp Z &kp X &kp C &kp V &kp B  &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT
    &kp LGUI &lt 1 TAB &kp SPACE  &kp RET &kp BSPC &kp RALT
   >;
  };
  function {
   display-name = "Numbers / Studio";
   bindings = <
    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5  &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
    &kp ESC &kp LALT &kp LCTRL &kp LSHFT &kp MINUS  &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp EQUAL
    &studio_unlock &kp GRAVE &kp LBKT &kp RBKT &kp BSLH &kp DEL  &kp HOME &kp END &kp PG_UP &kp PG_DN &kp SQT &trans
    &bt BT_SEL 0 &trans &out OUT_USB  &trans &trans &bt BT_SEL 1
   >;
  };
 };
};
